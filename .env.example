# MuseotekBox's own Postgres, run via `docker compose up -d`. Copy to `.env`; `.env` is
# never committed.

DB_USERNAME=museotek
DB_PASSWORD=change-me

# Only needed if 5432 is already taken on your host (e.g. a native Postgres install).
# If you change this, also update DB_URL / SPRING_DATASOURCE_URL for the backend itself
# to point at the new port.
DB_PORT=5432
